# The script of the game goes in this file.

# Declare characters used by this game. The color argument colorizes the
# name of the character.

init python:
    class Love_Interest:
        def __init__(self, name, who_color, aggression, assertion, envy):
            self.c = Character(name, who_color=who_color)
            self.name = name
            self.aggression = aggression #will affect endings ie more dangerous endings
            self.assertion = assertion #will affect endings, especially for Yamato
            self.envy = envy #will affect endings, especially for Kuro

    class Heroine:
        def __init__(self, name, who_color, corruption, assertion):
            self.c = Character(name, who_color=who_color)
            self.name = name
            self.corruption = corruption #affects endings, especially for Amadeus
            self.assertion = assertion #affects endings, especially for Kuro and Amadeus

    

transform left:
    xalign 0.0
    yalign 1.0
transform slightleft:
    xalign 0.25
    yalign 1.0
transform right:
    xalign 1.0
    yalign 1.0
transform slightright:
    xalign 0.75
    yalign 1.0

# The game starts here.

label start:
    #Variables will go here
    $ Ri = Heroine("Rina", "#81fdbd", 0, 2)
    $ Y = Love_Interest("Yamato", "#321ca0", 0, 1, 0)
    $ A = Love_Interest("Amadeus", "#02722d", 6, 7, 0)
    $ K = Love_Interest("Kuro", "#530363", 7, 5, 4)
    $ Ra = Love_Interest("Raphael", "#f4b507", 0, 7, 0)

    define Narrator = Character(None, what_italic=True)
    default Raphael_Route_Unlocked = False #set to true when the player has completed the game or entered a password 
    default Kuro_Love_Status = False #sets if Kuro falls for Rina in the common route, will affect all routes

